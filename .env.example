# Copia este archivo a .env y ajusta los valores

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Producción (Render): DEBUG=False, ALLOWED_HOSTS=.onrender.com
# CSRF_TRUSTED_ORIGINS=https://*.onrender.com

USE_SQLITE=True

# MySQL (USE_SQLITE=False). Valores inventados: sustitúyelos en tu .env local.
# DB_NAME=nombre_de_tu_base
# DB_USER=usuario_de_ejemplo
# DB_PASSWORD=cambia-esta-clave
# DB_HOST=127.0.0.1
# DB_PORT=puerto_mysql

# Solo si DEBUG=False. Render ya define SECRET_KEY, DEBUG, hosts y CSRF.
# SECURE_SSL_REDIRECT=False

# Email (desarrollo: consola; producción: SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=cambia-esta-clave
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@example.com

# Sentry (opcional)
# SENTRY_DSN=https://public@o000000.ingest.sentry.io/0000000
# SENTRY_TRACES_SAMPLE_RATE=0.1
