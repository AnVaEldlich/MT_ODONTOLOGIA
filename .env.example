# Copia este archivo a .env y ajusta los valores.
# Si ya tienes un .env, no lo reemplaces: ahí están tus credenciales reales.
#
# Sin variables, settings.py arranca en modo producción: DEBUG=False, MySQL y
# exige SECRET_KEY, ALLOWED_HOSTS y CSRF_TRUSTED_ORIGINS (falla con
# ImproperlyConfigured si faltan). Para trabajar en tu máquina deja DEBUG=True.
# Una variable ya definida en la shell o en CI gana sobre la de este archivo.

# --- Desarrollo local ---
DEBUG=True
# Con DEBUG=True puede faltar y se usa una clave de desarrollo. Ponla igual.
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# True: SQLite (arranque rápido). False: MySQL con las variables DB_*.
# pytest siempre usa SQLite, aunque aquí diga False.
USE_SQLITE=True

# MySQL. Valores inventados. En tu máquina usa los de tu base, sin commitear el .env.
DB_NAME=odontologia_ejemplo
DB_USER=odontologia_app
DB_PASSWORD=clave-inventada-ejemplo
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Producción (DEBUG=False) ---
# Obligatorias. Render ya las define en render.yaml.
# SECRET_KEY=una-clave-aleatoria-de-al-menos-50-caracteres
# ALLOWED_HOSTS=clinica.example.com,www.clinica.example.com
# CSRF_TRUSTED_ORIGINS=https://clinica.example.com,https://www.clinica.example.com
#
# Opcionales. Se aplican solo sin DEBUG; estos son los valores por defecto.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Opcional. Sin REDIS_URL el chat en vivo usa la memoria de ese proceso.
# Con varios procesos (gunicorn/daphne) define la URL para que el WebSocket se comparta.
# REDIS_URL=redis://127.0.0.1:6379/0

# Email (desarrollo: consola; producción: SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=cambia-esta-clave
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@example.com

# Sentry (opcional)
# SENTRY_DSN=https://public@o000000.ingest.sentry.io/0000000
# SENTRY_TRACES_SAMPLE_RATE=0.1
